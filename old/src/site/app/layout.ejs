<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= locals.metadata?.title || 'The Plug Afrique' %>
  </title>
  <% if (locals.metadata?.description) { %>
    <meta name="description" content="<%= locals.metadata.description %>">
  <% } %>
  <% if (locals.metadata?.keywords) { %>
    <meta name="keywords" content="<%= locals.metadata.keywords.join(', ') %>">
  <% } %>

  <!-- Open Graph / Social Media Meta Tags -->
  <% if (locals.metadata?.og) { %>
    <meta property="og:type" content="<%= locals.metadata.og.type || 'website' %>">
    <% if (locals.metadata.og.url) { %>
      <meta property="og:url" content="<%= locals.metadata.og.url %>">
    <% } %>
    <meta property="og:title" content="<%= locals.metadata.og.title || locals.metadata.title %>">
    <meta property="og:description" content="<%= locals.metadata.og.description || locals.metadata.description %>">
    <% if (locals.metadata.og.image) { %>
      <meta property="og:image" content="<%= locals.metadata.og.image %>">
    <% } %>
  <% } %>

  <!-- Twitter Meta Tags -->
  <% if (locals.metadata?.twitter) { %>
    <meta property="twitter:card" content="<%= locals.metadata.twitter.card || 'summary' %>">
    <% if (locals.metadata.twitter.url) { %>
      <meta property="twitter:url" content="<%= locals.metadata.twitter.url %>">
    <% } %>
    <meta property="twitter:title" content="<%= locals.metadata.twitter.title || locals.metadata.title %>">
    <meta property="twitter:description" content="<%= locals.metadata.twitter.description || locals.metadata.description %>">
    <% if (locals.metadata.twitter.image) { %>
      <meta property="twitter:image" content="<%= locals.metadata.twitter.image %>">
    <% } %>
  <% } %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="assets/css/bootstrap.css">
  <link rel="stylesheet" href="assets/css/animate.css">
  <link rel="stylesheet" href="assets/css/swiper-bundle.css">
  <link rel="stylesheet" href="assets/css/slick.css">
  <link rel="stylesheet" href="assets/css/magnific-popup.css">
  <link rel="stylesheet" href="assets/css/font-awesome-pro.css">
  <link rel="stylesheet" href="assets/css/spacing.css">
  <link rel="stylesheet" href="assets/css/main.css">

</head>

<body class="tp-bg-common-white-2 tp-magic-cursor">

  <div id="magic-cursor" class="cursor-white-bg">
    <div id="ball"></div>
  </div>

  <div class="preloader">
    <div class="loading"></div>
  </div>

  <div class="back-to-top-wrapper">
    <button id="back_to_top" type="button" class="back-to-top-btn">
      <svg width="12" height="7" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M11 6L6 1L1 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
          stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <%- include('../components/canvas-start') %>

    <%- include('../components/search-overlay') %>
      <%- include('../components/header') %>
        <div id="smooth-wrapper">
          <div id="smooth-content">
            <main>
              <% if (locals.layoutChain && locals.layoutChain.length> 1) { %>
                <%- include('../' + locals.layoutChain[1], { body: body }) %>
                  <% } else { %>
                    <%- body %>
                      <% } %>
            </main>
            <%- include('../components/footer') %>
          </div>
        </div>

          <script src="assets/js/vendor/jquery.js"></script>
          <script src="assets/js/bootstrap-bundle.js"></script>
          <script src="assets/js/plugin.js"></script>
          <script src="assets/js/swiper-bundle.js"></script>
          <script src="assets/js/magnific-popup.js"></script>
          <script src="assets/js/nice-select.js"></script>
          <script src="assets/js/purecounter.js"></script>
          <script src="assets/js/wow.js"></script>
          <script src="assets/js/isotope-pkgd.js"></script>
          <script src="assets/js/imagesloaded-pkgd.js"></script>
          <script src="assets/js/ajax-form.js"></script>
          <script src="assets/js/jarallax.js"></script>
          <script src="assets/js/parallax.js"></script> 
          <script src="assets/js/parallax-scrool.js"></script>
          <script src="assets/js/slider-init.js"></script> 
          <script src="assets/js/main.js"></script> 
          <script src="assets/js/tp-cursor.js"></script>
          <% if (locals.isDevelopment) { %>
            <script src="http://localhost:35729/livereload.js?snipver=1"></script>
          <% } %>
</body>

</html>