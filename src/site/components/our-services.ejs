<div class="tp-service-area tp-bg-common-white pb-140 pt-135" id="services">
  <div class="container-fluid container-1690">
    <div class="row align-items-end mb-25">
      <div class="col-lg-9">
        <div class="tp-service-6-title-wrap mb-30">
          <span class="fw-500 fs-16 tp-text-grey-1 mb-5 d-inline-block"
            >Explore our services for startup</span
          >
          <h2 class="mb-20 fs-xl-40 fs-sm-36 text-anim">
            Service we provide your business<br />
            corporate
            <span class="text-italic fw-400 tp-ff-heading">consulting.</span>
          </h2>
        </div>
      </div>
      <div class="col-lg-3">
        <div class="tp-service-6-btn text-lg-end mb-35">
          <a
            href="/services"
            class="tp-btn-xl d-inline-block lh-0 tp-round-26 fs-16 ls-0 tp-btn-switch-animation tp-text-theme-primary hover-text-black border-full-1 fw-500"
          >
            <span class="d-flex align-items-center justify-content-center">
              <span class="btn-text"> See all service</span>
              <span class="btn-icon"
                ><i class="fa-sharp fa-regular fa-arrow-right"></i
              ></span>
              <span class="btn-icon"
                ><i class="fa-sharp fa-regular fa-arrow-right"></i
              ></span>
            </span>
          </a>
        </div>
      </div>
    </div>
    <div class="row gx-0">
      <% locals.services.forEach((service, index) => { %>
      <% const delay = (index + 1) * 0.2; %>
      <div class="col-xl-3 col-lg-6 col-md-6">
        <div
          class="tp-service-6-wrap h-100 wow fadeInUp"
          data-wow-delay="<%= delay %>s"
          data-wow-duration=".9s"
        >
          <span
            class="tp-service-6-count mb-25 d-inline-block tp-bg-common-white-2 tp-round-4 fw-500 fs-14 ls-m-2 tp-text-theme-primary"
          >
            Service <%= String(index + 1).padStart(2, '0') %></span
          >
          <h3 class="fw-600 fs-24 ls-m-3 mb-10">
            <a href="/services/<%= service.data.slug %>"><%= service.data.name %></a>
          </h3>
          <p class="tp-text-grey-2 mb-30">
            <%= service.data.excerpt %>
          </p>
          <div class="tp-service-6-thumb text-center">
            <img src="<%= service.data.cover_image?.url %>" alt="<%= service.data.name %>" />
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</div>
