<!-- tp-breadcrumb-area-start -->
<div class="tp-hero-gsap-team-spacing" style="padding-top: 100px;">
  <div class="tp-breadcrumb-area anim-zoomin-wrap p-relative pt-200">
    <div class="tp-gsap-image-position anim-zoomin fix">
      <img
        class="tp-gsap-image-cover"
        src="<%= locals.pageHero?.bgImage || '/assets/img/breadcrumb/bg-13.jpg' %>"
        alt="<%= locals.pageHero?.title || 'Page Hero' %>"
      />
    </div>
    <div class="container">
      <div class="row">
        <div class="col-xl-6 col-lg-7 col-md-10">
          <div class="tp-breadcrumb-content mr-80">
            <h2
              class="tp-breadcrumb-title fw-600 fs-60 fs-xs-40 ls-m-3 text-anim tp-text-common-white lh-1"
            >
              <%= locals.pageHero?.title || 'Page Title' %>
            </h2>
            <div class="tp-breadcrumb-dvdr">
              <ul style="display: flex;">
                <% locals.pageHero?.breadcrumbs?.forEach((crumb, index) => { %>
                  <% if (crumb.href) { %>
                    <li><a href="<%= crumb.href %>"><%= crumb.label %></a></li>
                    <% } else { %>
                    <li style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 55%;"><%= crumb.label %></li>
                  <% } %>
                  <% if (index < locals.pageHero.breadcrumbs.length - 1) { %>
                    <li class="dvdr">/</li>
                  <% } %>
                <% }) %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- tp-breadcrumb-area-end -->
