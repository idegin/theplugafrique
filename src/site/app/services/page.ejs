<%- include('../../components/page-hero') %>

<!-- tp-service-area-start -->
<div
  class="tp-service-area pb-110 pt-135 tp-bg-common-white p-relative z-index-1"
>
  <div class="container">
    <div class="row align-items-end mb-35">
      <div class="col-xl-9">
        <div class="tp-service-2-title-wrap">
          <span class="fw-500 fs-16 tp-text-grey-1 mb-5 d-inline-block"
            >// Explore our services</span
          >
          <h2 class="mb-20 fs-sm-36 tp-text-revel-anim">
            Service for your
            <span class="tp-text-grey-1 text-italic fw-400 tp-ff-heading"
              >development</span
            >
          </h2>
        </div>
      </div>
      <div class="col-xl-3">
        
      </div>
    </div>
    <div class="row">
      <% if (locals.services && locals.services.length > 0) { %>
        <% locals.services.forEach((service, index) => { %>
          <% const animations = ['fadeInLeft', 'fadeInUp', 'fadeInRight']; %>
          <% const animation = animations[index % 3]; %>
          <div class="col-lg-4 col-md-6">
            <div
              class="tp-service-2-wrap p-relative anim-zoomin-wrap fix mb-30 wow <%= animation %>"
              data-wow-delay=".3s"
              data-wow-duration=".9s"
              style="height: 25rem; overflow: hidden;"
            >
              <div class="tp-service-2-thumb anim-zoomin fix tp-round-4" style="overflow: hidden;">
                <img
                  class="w-100 tp-round-4"
                  src="<%= service.data.cover_image?.url || 'assets/img/service/two/thumb.jpg' %>"
                  alt="<%= service.data.name %>"
                  style="width: 100%; height: 100%; object-fit: cover;"
                />
              </div>
              <div class="tp-service-2-content p-absolute">
                <div class="tp-service-2-content-top d-flex align-items-center">
                  <span class="fw-500 fs-26 ls-m-2 tp-text-common-white">
                    <a href="/services/<%= service.data.slug %>" class="hover-text-white">
                      <%= service.data.name %>
                    </a>
                  </span>
                </div>
                <div class="tp-service-2-content-bottom pt-20 mt-15">
                  <p class="mb-0 tp-text-grey-3 lh-24">
                    <%= service.data.excerpt %>
                  </p>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>
<!-- tp-service-area-end -->
