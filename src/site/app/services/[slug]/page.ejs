<%- include('../../../components/page-hero') %>


  <div class="tp-project-details-area pt-140 pb-90">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="tp-project-details-content">
            <% if (locals.service && locals.service.data) { %>
              <div class="tp-project-details-content-main">
                <% if (locals.service.data.name) { %>
                  <h2 class="fs-40 fw-600 ls-m-2 mb-30 text-anim"><%= locals.service.data.name %></h2>
                <% } %>
                
                <% if (locals.service.data.content) { %>
                  <div class="service-content fs-18">
                    <%- locals.service.data.content %>
                  </div>
                <% } %>
              </div>
            <% } %>
            
          </div>
        </div>
      </div>
    </div>
  </div>

