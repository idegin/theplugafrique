  <div class="tp-sidebar-widget tp-sidebar-border mb-45">
    <div class="tp-sidebar-widget-content">
      <h3 class="tp-sidebar-widget-title fw-600 fs-24 ls-m-2 mb-20">
        Categories
      </h3>
      <ul>
        <% locals.categories.slice(0, 5).forEach((category) => { %>
        <li>
          <a href="/blog?category=<%= category.data.slug %>" class="d-flex align-items-center justify-content-between">
            <span>
              <svg width="20" height="22" viewBox="0 0 20 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9.31978 10.6864C11.9946 10.6864 14.163 8.51805 14.163 5.84322C14.163 3.16838 11.9946 1 9.31978 1C6.64494 1 4.47656 3.16838 4.47656 5.84322C4.47656 8.51805 6.64494 10.6864 9.31978 10.6864Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M16.3031 14.3092L12.8741 17.7382C12.7385 17.8739 12.6126 18.1257 12.5835 18.3097L12.3995 19.6174C12.3317 20.092 12.661 20.4213 13.1356 20.3535L14.4433 20.1695C14.6273 20.1404 14.8889 20.0145 15.0148 19.8789L18.4438 16.4499C19.0347 15.8591 19.3156 15.1713 18.4438 14.2995C17.5817 13.4374 16.894 13.7183 16.3031 14.3092Z" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M15.8086 14.8032C16.0992 15.8494 16.9128 16.663 17.959 16.9536" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M1 20.3729C1 16.6243 4.7293 13.5924 9.32067 13.5924C10.3281 13.5924 11.2967 13.7377 12.1975 14.0089" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <%= category.data.name %>
            </span>
            <span><i class="fa-solid fa-angle-right"></i></span>
          </a>
        </li>
        <% }) %>
      </ul>
    </div>
  </div>
  <div class="tp-sidebar-widget mb-45">
    <div class="tp-sidebar-post">
      <h3 class="tp-sidebar-widget-title fw-600 fs-24 ls-m-2 mb-20">
        Latest blog post
      </h3>
      <% locals.latestBlogs.slice(0, 4).forEach((post) => { %>
      <div class="tp-sidebar-rc-post d-flex align-items-center mb-10">
        <div class="tp-sidebar-rc-post-thumb mr-25" style="height: 5rem; width: 10rem; overflow: hidden;">
          <img src="<%= post.data.thumbnail?.url || '/assets/img/blog/sidebar/avatar.jpg' %>" alt="<%= post.data.name %>" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
        <div class="tp-sidebar-rc-post-content">
          <h4 class="tp-sidebar-rc-post-title fw-500 fs-16 ls-m-2 mb-0">
            <a href="/blog/<%= post.data.slug %>" class="underline-black"><%= post.data.name %></a>
          </h4>
          <div class="tp-sidebar-rc-meta">
            <span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7 12.9999C10.3137 12.9999 13 10.3136 13 6.99988C13 3.68617 10.3137 0.999878 7 0.999878C3.68629 0.999878 1 3.68617 1 6.99988C1 10.3136 3.68629 12.9999 7 12.9999Z" stroke="#506767" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M7 3.39978V6.99978L9.4 8.19978" stroke="#506767" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span><%= new Date(post.createdAt).toLocaleDateString() %></span>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>

</div>
