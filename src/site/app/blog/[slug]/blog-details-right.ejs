          <div class="p-relative d-inline-block mr-25" style="height: 5rem; width: 5rem; overflow: hidden;">
            <img
              class="rounded-circle"
              src="<%= locals.blog.data.author.data.avatar?.url || '/assets/img/blog/sidebar/user.png' %>"
              alt="<%= locals.blog.data.author.data.name %>"
            />
            <span class="tp-sidebar-author-active"></span>
          </div>
          <div>
            <h3 class="fw-600 fs-18 ls-m-2 mb-0"><%= locals.blog.data.author.data.name %></h3>
            <span class="fw-400 fs-14 ls-m-2 tp-text-grey-1"><%= locals.blog.data.author.data.role || 'Author' %></span>
          </div>
        </div>
