<div class="tp-sidebar-wrapper">
  <div class="tp-sidebar-widget mb-50">
    <div class="tp-sidebar-search">
      <form action="#">
        <div class="tp-sidebar-search-input p-relative">
          <input type="text" placeholder="Enter your keywords..." />
          <button type="submit">
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M7.22222 13.4444C10.6587 13.4444 13.4444 10.6587 13.4444 7.22222C13.4444 3.78578 10.6587 1 7.22222 1C3.78578 1 1 3.78578 1 7.22222C1 10.6587 3.78578 13.4444 7.22222 13.4444Z"
                stroke="#141820"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M15 15.0002L11.6167 11.6169"
                stroke="#141820"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>
  <div class="tp-sidebar-widget mb-50">
