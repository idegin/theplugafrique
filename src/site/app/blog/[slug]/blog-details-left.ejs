<% const date = new Date(locals.blog.createdAt); %>
<% const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); %>

<div class="tp-postbox-details-wrapper mr-50 mb-50">
  <article class="tp-postbox-details-item mb-50">
    <div class="tp-postbox-thumb mb-30">
      <img
        class="w-100 tp-round-4"
        src="<%= locals.blog.data.thumbnail?.url %>"
        alt="<%= locals.blog.data.name %>"
      />
    </div>
    <div class="tp-postbox-content">
      <div class="tp-postbox-meta-item mb-30">
        <div
          class="tp-postbox-meta-single d-flex align-items-center mr-50 mb-20"
        >
          <div class="mr-15">
            <img
              class="rounded-circle"
              src="<%= locals.blog.data.author.data.avatar?.url %>"
              alt="<%= locals.blog.data.author.data.name %>"
              style="width: 50px; height: 50px; object-fit: cover;"
            />
          </div>
          <div>
            <span class="fw-400 fs-14 tp-text-grey-1">Author</span>
            <h6 class="fw-500 fs-16 mb-0"><%= locals.blog.data.author.data.name %></h6>
          </div>
        </div>
        <div class="tp-postbox-meta-single mr-50 mb-20">
          <span class="fw-400 fs-14 tp-text-grey-1">Published</span>
          <h6 class="fw-500 fs-16 mb-0"><%= formattedDate %></h6>
        </div>
      </div>
      <h3 class="fw-600 fs-42 ls-m-2 mb-20 fs-lg-35 fs-sm-30">
        <%= locals.blog.data.name %>
      </h3>
      <div class="mb-25 blog-content">
        <%- locals.blog.data.content %>
      </div>
      
      <div
        class="tp-postbox-details-author-box tp-bg-grey-3 d-sm-flex tp-round-4 p-relative mb-70"
      >
        <span class="tp-postbox-details-author-qoute">
          <svg
            width="168"
            height="98"
            viewBox="0 0 168 98"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M0 72.0001H35.9999L11.9998 120H47.9997L71.9999 72.0001V0H0V72.0001Z"
              fill="#F6F6F6"
            />
            <path
              d="M96 0V72.0001H132L108 120H144L168 72.0001V0H96Z"
              fill="#F6F6F6"
            />
          </svg>
        </span>
        <div class="tp-postbox-details-author-avatar mr-20 mb-10">
          <img src="<%= locals.blog.data.author.data.avatar?.url %>" alt="<%= locals.blog.data.author.data.name %>" style="width: 100px; height: 100px; object-fit: cover; border-radius: 50%;" />
        </div>
        <div class="tp-postbox-details-author-content">
          <h4><%= locals.blog.data.author.data.name %></h4>
          <div class="mb-20">
            <%- locals.blog.data.author.data.about || '' %>
          </div>
          <div class="tp-postbox-details-author-social">
            <p><%= locals.blog.data.author.data.role %></p>
          </div>
        </div>
      </div>
      
      <div class="tp-postbox-details-feature-list tp-sidebar-widget mb-65">
        <span class="fw-600 fs-18 ls-m-2 d-inline-block mr-30">Categories:</span>
        <div class="tagcloud d-inline-block">
          <% locals.blog.data.categories.forEach((cat) => { %>
            <a href="/blog?category=<%= cat.data.slug %>"><%= cat.data.name %></a>
          <% }) %>
        </div>
      </div>
      
      
    </div>
  </article>
</div>
