<% const date = new Date(locals.blog.createdAt); %>
<% const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); %>

<div class="tp-postbox-details-wrapper mr-50 mb-50">
  <article class="tp-postbox-details-item mb-50">
    <div class="tp-postbox-thumb mb-30">
      <img
        class="w-100 tp-round-4"
        src="<%= locals.blog.data.thumbnail[0]?.url %>"
        alt="<%= locals.blog.data.name %>"
      />
    </div>
    <div class="tp-postbox-content">
      <div class="tp-postbox-meta-item mb-30">
        <div
          class="tp-postbox-meta-single d-flex align-items-center mr-50 mb-20"
        >
          <div class="mr-15">
            <img
              class="rounded-circle"
              src="<%= locals.blog.data.author.data.avatar[0]?.url %>"
              alt="<%= locals.blog.data.author.data.name %>"
              style="width: 50px; height: 50px; object-fit: cover;"
            />
          </div>
          <div>
            <span class="fw-400 fs-14 tp-text-grey-1">Author</span>
            <h6 class="fw-500 fs-16 mb-0"><%= locals.blog.data.author.data.name %></h6>
          </div>
        </div>
        <div class="tp-postbox-meta-single mr-50 mb-20">
          <span class="fw-400 fs-14 tp-text-grey-1">Published</span>
          <h6 class="fw-500 fs-16 mb-0"><%= formattedDate %></h6>
        </div>
        <div class="tp-postbox-meta-single mb-20 mr-50">
          <span class="fw-400 fs-14 tp-text-grey-1">2 Comments</span>
          <h6 class="fw-500 fs-16 mb-0">Join the Conversation</h6>
        </div>
        <div class="tp-postbox-meta-single mb-20">
          <span class="fw-400 fs-14 tp-text-grey-1">View</span>
          <h6 class="fw-500 fs-16 mb-0">12,145 views</h6>
        </div>
      </div>
      <h3 class="fw-600 fs-42 ls-m-2 mb-20 fs-lg-35 fs-sm-30">
        <%= locals.blog.data.name %>
      </h3>
      <div class="mb-25 blog-content">
        <%- locals.blog.data.content %>
      </div>
      
      <div
        class="tp-postbox-details-author-box tp-bg-grey-3 d-sm-flex tp-round-4 p-relative mb-70"
      >
        <span class="tp-postbox-details-author-qoute">
          <svg
            width="168"
            height="98"
            viewBox="0 0 168 98"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M0 72.0001H35.9999L11.9998 120H47.9997L71.9999 72.0001V0H0V72.0001Z"
              fill="#F6F6F6"
            />
            <path
              d="M96 0V72.0001H132L108 120H144L168 72.0001V0H96Z"
              fill="#F6F6F6"
            />
          </svg>
        </span>
        <div class="tp-postbox-details-author-avatar mr-20 mb-10">
          <img src="<%= locals.blog.data.author.data.avatar[0]?.url %>" alt="<%= locals.blog.data.author.data.name %>" style="width: 100px; height: 100px; object-fit: cover; border-radius: 50%;" />
        </div>
        <div class="tp-postbox-details-author-content">
          <h4><%= locals.blog.data.author.data.name %></h4>
          <div class="mb-20">
            <%- locals.blog.data.author.data.about || '' %>
          </div>
          <div class="tp-postbox-details-author-social">
            <ul>
              <li>
                <a href="#">
                  <svg
                    width="9"
                    height="16"
                    viewBox="0 0 9 16"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M2.403 9.03129C2.34293 9.03129 1.02128 9.03129 0.420526 9.03129C0.100125 9.03129 0 8.91114 0 8.61076C0 7.80976 0 6.98874 0 6.18773C0 5.86733 0.12015 5.76721 0.420526 5.76721H2.403C2.403 5.70713 2.403 4.54568 2.403 4.00501C2.403 3.20401 2.54318 2.44305 2.94368 1.74218C3.3642 1.02128 3.96496 0.540676 4.72591 0.260325C5.22653 0.0801 5.72716 0 6.26783 0H8.23029C8.51064 0 8.63079 0.12015 8.63079 0.400501V2.68335C8.63079 2.9637 8.51064 3.08385 8.23029 3.08385C7.68961 3.08385 7.14894 3.08385 6.60826 3.10388C6.06758 3.10388 5.78723 3.36421 5.78723 3.92491C5.76721 4.52566 5.78723 5.10638 5.78723 5.72716H8.11014C8.43054 5.72716 8.55069 5.84731 8.55069 6.16771V8.59074C8.55069 8.91114 8.45056 9.01126 8.11014 9.01126C7.38924 9.01126 5.84731 9.01126 5.78723 9.01126V15.5394C5.78723 15.8798 5.68711 16 5.32666 16C4.48561 16 3.66458 16 2.82353 16C2.52315 16 2.403 15.8799 2.403 15.5795C2.403 13.4768 2.403 9.09136 2.403 9.03129Z"
                      fill="currentColor"
                    />
                  </svg>
                </a>
              </li>
              <li>
                <a href="#">
                  <svg
                    width="19"
                    height="16"
                    viewBox="0 0 19 16"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M0.743794 5.331C0.743794 5.331 2.28009 4.12018 2.79238 4.72531C3.3041 5.331 5.25871 12.64 5.91139 13.9878C6.48098 15.1705 8.05166 16.7332 9.77419 15.6169C11.4956 14.5006 17.2213 9.61269 18.2459 3.84055C19.2699 -1.92988 11.3563 -0.721354 10.518 4.30642C12.613 3.04862 13.7315 4.81699 12.6594 6.82031C11.589 8.82133 10.6108 10.1261 10.0997 10.1261C9.58853 10.1261 9.19543 8.78695 8.60979 6.44669C8.00524 4.02735 8.00811 -0.330546 5.49193 0.163406C3.11843 0.62928 0 4.35341 0 4.35341L0.743794 5.331Z"
                      fill="currentColor"
                    />
                  </svg>
                </a>
              </li>
              <li>
                <a href="#">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M9.60319 6.77491L15.4315 0H14.0504L8.98966 5.88256L4.94769 0H0.285767L6.39801 8.89547L0.285767 16H1.66696L7.01119 9.78782L11.2798 16H15.9417L9.60285 6.77491H9.60319ZM7.71145 8.97384L7.09216 8.08805L2.16463 1.03974H4.28606L8.26263 6.72795L8.88193 7.61374L14.051 15.0075H11.9296L7.71145 8.97418V8.97384Z"
                      fill="currentColor"
                    />
                  </svg>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="tp-postbox-details-feature-list tp-sidebar-widget mb-65">
        <span class="fw-600 fs-18 ls-m-2 d-inline-block mr-30">Categories:</span>
        <div class="tagcloud d-inline-block">
          <% locals.blog.data.categories.forEach((cat) => { %>
            <a href="/category/<%= cat.data.slug %>"><%= cat.data.name %></a>
          <% }) %>
        </div>
      </div>
      
      
    </div>
  </article>
</div>
